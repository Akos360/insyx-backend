# PostgreSQL connection — accounts live in insyx-database's own Postgres
# (database `insyx`, created there by conf/postgres/migrations/001_users.sql +
# 002_users_auth_compat.sql), not a Postgres container of this repo's own.
# Below is for running backend locally (outside Docker) — use 127.0.0.1, not
# localhost (see TRINO_HOST comment below). When running inside Docker,
# DB_HOST is overridden in docker-compose.yml to host.docker.internal instead.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=insyx

# Lakehouse (Trino/Iceberg, from the separate insyx-database repo)
# Use 127.0.0.1, not localhost — on Windows w/ Docker Desktop, localhost can resolve
# to ::1 and the IPv6 path resets connections to Trino.
TRINO_HOST=http://127.0.0.1:8080
TRINO_CATALOG=iceberg
TRINO_SCHEMA=scisci
TRINO_USER=insyx-backend
#TRINO_PASSWORD=   # only needed if Trino has an authenticator configured

# Auth — signs access/refresh JWTs. Generate a long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Used to build password-reset links.
FRONTEND_URL=http://127.0.0.1:8081
# Google OAuth Client ID (Identity Services ID-token flow — no client secret
# needed). Google Cloud Console -> APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Web application; add your frontend
# origin(s) as authorized JavaScript origins.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
