# PostgreSQL connection — used when running backend locally (outside Docker)
# When running inside Docker, DB_HOST/DB_PORT are overridden in docker-compose.yml
# to reach postgres:5432 over the internal Docker network.
DB_HOST=localhost
DB_PORT=5433
# Host-side port Docker Compose publishes Postgres on (see docker-compose.yml).
# Moved off 5432 to avoid colliding with insyx-database's own Postgres.
DB_HOST_PORT=5433
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=insyx

# Lakehouse (Trino/Iceberg, from the separate insyx-database repo)
# Use 127.0.0.1, not localhost — on Windows w/ Docker Desktop, localhost can resolve
# to ::1 and the IPv6 path resets connections to Trino.
TRINO_HOST=http://127.0.0.1:8080
TRINO_CATALOG=iceberg
TRINO_SCHEMA=scisci
TRINO_USER=insyx-backend
#TRINO_PASSWORD=   # only needed if Trino has an authenticator configured
